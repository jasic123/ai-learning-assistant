# 无真实密钥的配置模板：复制为项目根目录 .env 后，在本机填写实际值。
# LLM_*、EMBEDDING_*、RERANK_* 分别配置聊天、向量和精排服务，可使用不同提供商。
# 天气和 Tavily 网页搜索需要各自的 API Key。
# 聊天服务 API 基址，通常包含 /v1；不要将密钥写入 URL。
LLM_API_BASE=
# 聊天服务密钥，仅填写在本机 .env，不提交真实值。
LLM_API_KEY=
# 聊天模型的服务端标识，必须与提供商实际支持的名称一致。
LLM_MODEL=
# 向量服务 API 基址，建库与检索应使用同一兼容配置。
EMBEDDING_API_BASE=
# 向量服务密钥，可以与聊天服务密钥不同。
EMBEDDING_API_KEY=
# 向量模型名称；切换模型后应重建索引，不能仅比较维度。
EMBEDDING_MODEL=
# 可选精排服务：只有显式使用 --rerank 时读取。提供商必须支持 /rerank 接口。
# 基址包含版本路径（如 /v1），不包含 /rerank；不会自动复用聊天或向量密钥。
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=
# 心知天气服务密钥。
SENIVERSE_API_KEY=
# Tavily Search API Key，在 tavily.com 控制台创建；有免费额度。
TAVILY_API_KEY=
# 可选：网页搜索专用 HTTP 代理，例如 http://127.0.0.1:7890。
WEB_SEARCH_PROXY=
# 隔离代码执行服务的预留地址，不是本机任意代码执行开关。
CODEBOX_BASE_URL=
# 隔离代码执行服务的预留认证密钥。
CODEBOX_API_KEY=
# 前端访问后端的预留地址，后续界面集成时使用。
BACKEND_URL=http://127.0.0.1:8000
